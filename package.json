{
  "name": "fiscal",
  "version": "0.1.0",
  "private": true,
  "description": "Fiscal (Soarlyai Project): contabilità personale da psicologo in regime ordinario, in cumulo con il lavoro dipendente.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs && node scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-datepicker-compat": "0.6.41",
    "@fluentui/react-icons": "2.0.347",
    "@supabase/supabase-js": "2.119.2",
    "idb": "8.0.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "otpauth": "9.6.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
